/filters {
    /0001 { /type "deny" /glob "*" }
    /0010 { /type "allow" /method "GET" /url "/content/assessment/*.html" }
    /0012 { /type "allow" /method "GET" /url "/content/dam/*" }
    /0020 { /type "allow" /url "/etc.clientlibs/*" }
    /0030 { /type "allow" /method "GET" /url "/libs/granite/csrf/token.json" }
}

